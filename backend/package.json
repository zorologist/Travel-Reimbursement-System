{
  "_comment": "Backend dependencies and commands live here because the Express API is an independent workspace.",
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=../.env dist/server.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=../.env src/database/migrate.ts",
    "db:migrate:prod": "node --env-file=../.env dist/database/migrate.js",
    "db:seed:dev": "tsx --env-file=../.env src/database/seedDevelopment.ts",
    "db:seed:dev:prod": "node --env-file=../.env dist/database/seedDevelopment.js",
    "db:check": "tsx --env-file=../.env src/database/check.ts",
    "db:check:prod": "node --env-file=../.env dist/database/check.js",
    "db:check-write:prod": "node --env-file=../.env dist/database/checkStorageWrite.js",
    "db:import-users:prod": "node --env-file=../.env dist/database/importDirectoryUsers.js"
  },
  "dependencies": {
    "@travel-reimbursement/shared": "1.0.0",
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "pg": "8.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
