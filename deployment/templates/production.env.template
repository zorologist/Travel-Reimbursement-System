# Copy this file to .env in the application root on the company host.
# Replace every CHANGE_ON_SERVER value locally on that host. Never send or commit the completed file.
NODE_ENV=production
ALLOWED_ORIGINS=https://travel.egas.local

ALLOW_DEV_AUTH_HEADER=false
ENABLE_DEVELOPMENT_ACCOUNTS=false
# ldap shows a normal login form and verifies the password directly against
# Active Directory (LDAP simple bind). Switch to iis once Windows
# Authentication reliably forwards the identity header end to end.
AUTH_MODE=ldap
IIS_IDENTITY_HEADER=x-iis-windows-user
IIS_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1,::ffff:127.0.0.1
LDAP_URL=ldap://192.168.1.9:389
LDAP_DOMAIN=EGAS.Local

DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_NAME=travel_reimbursement
DATABASE_USER=travel_app
DATABASE_PASSWORD="CHANGE_ON_SERVER"
DATABASE_SSL=false
STORAGE_MODE=postgres

VITE_API_BASE_URL=
VITE_AUTH_MODE=ldap
VITE_USE_DEVELOPMENT_REPOSITORY=false

SERVE_FRONTEND=true
HOST=127.0.0.1
PORT=3000
