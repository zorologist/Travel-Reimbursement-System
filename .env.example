# Comma-separated browser origins allowed to send credentialed API requests.
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Local test-only escape hatch. Never enable in staging or production.
ALLOW_DEV_AUTH_HEADER=false

# Enable seeded DEV001-DEV010 logins on the separate development deployment.
# Keep this false on the active published deployment.
ENABLE_DEVELOPMENT_ACCOUNTS=false

# Use development locally. The company deployment uses iis after IIS Windows
# Authentication is configured to overwrite the trusted identity header.
AUTH_MODE=development
IIS_IDENTITY_HEADER=x-iis-windows-user
IIS_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1,::ffff:127.0.0.1

# The frontend normally uses the backend API.
VITE_API_BASE_URL=
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:5435
VITE_AUTH_MODE=development
VITE_USE_DEVELOPMENT_REPOSITORY=false

# Optional only for the explicitly enabled browser mock repository.
# Supply locally as a JSON object; do not commit real credentials.
VITE_DEVELOPMENT_ACCOUNTS=

# PostgreSQL connection used only by the backend. Keep the real password in
# an ignored local .env file or the company secret-management system.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=travel_reimbursement
DATABASE_USER=travel_app
DATABASE_PASSWORD=
DATABASE_SSL=false
STORAGE_MODE=postgres

# The Node API will use this internal port behind IIS in production.
SERVE_FRONTEND=false
HOST=127.0.0.1
PORT=5435
