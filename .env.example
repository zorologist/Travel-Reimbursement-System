# Comma-separated browser origins allowed to send credentialed API requests.
ALLOWED_ORIGINS=http://localhost:5173

# Local test-only escape hatch. Never enable in staging or production.
ALLOW_DEV_AUTH_HEADER=false

# Enable seeded DEV001-DEV010 logins on the separate development deployment.
# Keep this false on the active published deployment.
ENABLE_DEVELOPMENT_ACCOUNTS=false

# The frontend normally uses the backend API.
VITE_API_BASE_URL=
VITE_USE_DEVELOPMENT_REPOSITORY=false

# Optional only for the explicitly enabled browser mock repository.
# Supply locally as a JSON object; do not commit real credentials.
VITE_DEVELOPMENT_ACCOUNTS=
